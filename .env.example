VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Test login (dev only — shown on login page when VITE_TEST_EMAIL is set)
VITE_TEST_EMAIL=
VITE_TEST_PASSWORD=

# Dedicated "unlocked" replay account (dev/E2E only — shown when VITE_TEST_UNLOCKED_EMAIL is set).
# A SEPARATE Firebase account the E2E setup keeps seeded with every quest complete, so capstone/replay
# specs can replay any quest without touching the primary test user. Auto-created on first run if
# Email/Password sign-up is enabled in Firebase Auth; otherwise create it once in the console.
VITE_TEST_UNLOCKED_EMAIL=
VITE_TEST_UNLOCKED_PASSWORD=
