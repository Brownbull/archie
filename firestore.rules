rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // Component library collections — read-only for authenticated users
    match /components/{docId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /stacks/{docId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /blueprints/{docId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /connectionTypes/{docId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /metricCategories/{docId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /_metadata/{docId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // SECURITY: When adding user-writable collections (e.g., userProjects),
    // ALWAYS enforce ownership: allow write: if request.auth.uid == resource.data.userId;
    // NEVER use match /{document=**} with allow write: if isAuthenticated();

    // Challenge attempt history (Epic 17) — owner-only, immutable append-only log.
    match /attempts/{attemptId} {
      // Read only your own attempts.
      allow read: if isAuthenticated() && request.auth.uid == resource.data.userId;
      // Create only attempts stamped with your own uid. The full server-side validation below
      // mirrors AttemptStoredSchema (defense-in-depth — a raw REST/API client never reaches the
      // app's Zod check), requires EVERY field present + typed + in range (the `is`/range checks
      // imply presence; hasOnly forbids extras), and pins createdAt to the server clock so a client
      // cannot backdate/spoof a timestamp (serverTimestamp() resolves to request.time).
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasOnly([
             'userId', 'challengeId', 'stars', 'uptimePercent',
             'p99LatencyMs', 'totalCost', 'topologyIssueCount', 'createdAt'
           ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.challengeId is string
        && request.resource.data.challengeId.size() > 0
        && request.resource.data.challengeId.size() <= 200
        && request.resource.data.stars is int
        && request.resource.data.stars >= 0 && request.resource.data.stars <= 3
        && request.resource.data.uptimePercent is number
        && request.resource.data.uptimePercent >= 0 && request.resource.data.uptimePercent <= 100
        && request.resource.data.p99LatencyMs is number
        && request.resource.data.p99LatencyMs >= 0 && request.resource.data.p99LatencyMs <= 600000
        && request.resource.data.totalCost is number
        && request.resource.data.totalCost >= 0 && request.resource.data.totalCost <= 100000000
        && request.resource.data.topologyIssueCount is int
        && request.resource.data.topologyIssueCount >= 0 && request.resource.data.topologyIssueCount <= 10000
        && request.resource.data.createdAt == request.time;
      // Attempts are an immutable history — no edits or deletes.
      allow update, delete: if false;
    }

    // Mastery Tracks user progress (Phase 2, D45) — owner-only, keyed by uid.
    // Document id IS the user's uid, so the path itself enforces ownership.
    match /userProgress/{uid} {
      allow read: if isAuthenticated() && request.auth.uid == uid;
      allow create: if isAuthenticated()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['trackXp', 'completedChallenges', 'bestStarsCloud', 'equippedAvatar', 'hintsUnlocked', 'expertCurrency', 'breaksByChallenge', 'requiredFilterUnlocked', 'resilienceClears', 'generation', 'updatedAt'])
        && request.resource.data.trackXp is map
        && request.resource.data.completedChallenges is list
        && request.resource.data.completedChallenges.size() <= 200
        && (!('hintsUnlocked' in request.resource.data) || request.resource.data.hintsUnlocked is map)
        && (!('generation' in request.resource.data) || request.resource.data.generation is int)
        && (!('expertCurrency' in request.resource.data) || (request.resource.data.expertCurrency is int && request.resource.data.expertCurrency >= 0))
        && (!('breaksByChallenge' in request.resource.data) || request.resource.data.breaksByChallenge is map)
        && (!('requiredFilterUnlocked' in request.resource.data) || request.resource.data.requiredFilterUnlocked is map)
        && (!('resilienceClears' in request.resource.data) || request.resource.data.resilienceClears is map)
        && request.resource.data.updatedAt == request.time;
      allow update: if isAuthenticated()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['trackXp', 'completedChallenges', 'bestStarsCloud', 'equippedAvatar', 'hintsUnlocked', 'expertCurrency', 'breaksByChallenge', 'requiredFilterUnlocked', 'resilienceClears', 'generation', 'updatedAt'])
        && request.resource.data.trackXp is map
        && request.resource.data.completedChallenges is list
        && request.resource.data.completedChallenges.size() <= 200
        && (!('hintsUnlocked' in request.resource.data) || request.resource.data.hintsUnlocked is map)
        && (!('generation' in request.resource.data) || request.resource.data.generation is int)
        && (!('expertCurrency' in request.resource.data) || (request.resource.data.expertCurrency is int && request.resource.data.expertCurrency >= 0))
        && (!('breaksByChallenge' in request.resource.data) || request.resource.data.breaksByChallenge is map)
        && (!('requiredFilterUnlocked' in request.resource.data) || request.resource.data.requiredFilterUnlocked is map)
        && (!('resilienceClears' in request.resource.data) || request.resource.data.resilienceClears is map)
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // User-created challenges (Phase 5, D45) — owner-only, keyed by uid.
    match /userChallenges/{uid} {
      allow read: if isAuthenticated() && request.auth.uid == uid;
      allow create: if isAuthenticated()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['challenges', 'updatedAt'])
        && request.resource.data.challenges is list
        && request.resource.data.challenges.size() <= 100
        && request.resource.data.updatedAt == request.time;
      allow update: if isAuthenticated()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['challenges', 'updatedAt'])
        && request.resource.data.challenges is list
        && request.resource.data.challenges.size() <= 100
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // Per-type block configuration defaults — owner-only, keyed by uid.
    // Document id IS the user's uid, so the path itself enforces ownership.
    // `defaults` maps a block typeId → { providerId, variantId } chosen by the user.
    match /userBlockDefaults/{uid} {
      allow read: if isAuthenticated() && request.auth.uid == uid;
      allow create: if isAuthenticated()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['defaults', 'updatedAt'])
        && request.resource.data.defaults is map
        && request.resource.data.updatedAt == request.time;
      allow update: if isAuthenticated()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['defaults', 'updatedAt'])
        && request.resource.data.defaults is map
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // Saved canvases — up to 2 named slots per user, owner-only, keyed by uid.
    // `slots` is a fixed-length list (≤2) of {name, savedAt, canvas} or null.
    match /userCanvases/{uid} {
      allow read: if isAuthenticated() && request.auth.uid == uid;
      allow create: if isAuthenticated()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['slots', 'updatedAt'])
        && request.resource.data.slots is list
        && request.resource.data.slots.size() <= 2
        && request.resource.data.updatedAt == request.time;
      allow update: if isAuthenticated()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['slots', 'updatedAt'])
        && request.resource.data.slots is list
        && request.resource.data.slots.size() <= 2
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // Deny all by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
