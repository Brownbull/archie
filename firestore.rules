rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // Component library collections — read-only for authenticated users
    match /components/{docId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /stacks/{docId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /blueprints/{docId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /connectionTypes/{docId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /metricCategories/{docId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /_metadata/{docId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // SECURITY: When adding user-writable collections (e.g., userProjects),
    // ALWAYS enforce ownership: allow write: if request.auth.uid == resource.data.userId;
    // NEVER use match /{document=**} with allow write: if isAuthenticated();

    // Challenge attempt history (Epic 17) — owner-only, immutable append-only log.
    match /attempts/{attemptId} {
      // Read only your own attempts.
      allow read: if isAuthenticated() && request.auth.uid == resource.data.userId;
      // Create only attempts stamped with your own uid; validate the shape so a client can't
      // write arbitrary fields or spoof another user's ownership.
      allow create: if isAuthenticated()
        && request.auth.uid == request.resource.data.userId
        && request.resource.data.keys().hasOnly([
             'userId', 'challengeId', 'stars', 'uptimePercent',
             'p99LatencyMs', 'totalCost', 'topologyIssueCount', 'createdAt'
           ])
        && request.resource.data.stars is int
        && request.resource.data.stars >= 0 && request.resource.data.stars <= 3
        && request.resource.data.challengeId is string
        && request.resource.data.challengeId.size() > 0;
      // Attempts are an immutable history — no edits or deletes.
      allow update, delete: if false;
    }

    // Deny all by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
